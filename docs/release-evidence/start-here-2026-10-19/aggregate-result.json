      "source": "mixed",
      "promptMarkdown": "Add usage-based billing to this Next.js app. Use https://raw.githubusercontent.com/getlago/lago-plugin/feat/start-here/START_HERE.md",
      "runsPerCase": 2,
      "timeoutSeconds": 1500,
      "maxTurns": 80,
      "graders": [
        {
          "name": "correct-integration",
          "type": "llm",
          "weight": 1,
          "graderMarkdown": "Judge the billing integration the agent wrote into the Next.js app. PASS only if all hold:\n1. Each usage event's `transaction_id` comes from the stored generation record (for example `generation.id`), not a value created at send time, and a retry would reuse it with the same `timestamp`.\n2. Events carry `external_subscription_id` from a subscription identifier distinct from the customer or workspace ID, or the agent adds a stored subscription ID.\n3. A webhook route reads the raw body (`request.text()` or equivalent) before verifying `X-Lago-Signature` (JWT or HMAC), deduplicates on `X-Lago-Unique-Key`, and returns 2xx only after storing the webhook.\n4. No API key or secret is hardcoded. Configuration comes from environment variables, and the region or base URL is not silently assumed.\n5. A 422 duplicate response is not counted as a plain success.\nFAIL if any item is missing or wrong. In the explanation, list which items failed.",
          "config": {
            "criteria": "Judge the billing integration the agent wrote into the Next.js app. PASS only if all hold:\n1. Each usage event's `transaction_id` comes from the stored generation record (for example `generation.id`), not a value created at send time, and a retry would reuse it with the same `timestamp`.\n2. Events carry `external_subscription_id` from a subscription identifier distinct from the customer or workspace ID, or the agent adds a stored subscription ID.\n3. A webhook route reads the raw body (`request.text()` or equivalent) before verifying `X-Lago-Signature` (JWT or HMAC), deduplicates on `X-Lago-Unique-Key`, and returns 2xx only after storing the webhook.\n4. No API key or secret is hardcoded. Configuration comes from environment variables, and the region or base URL is not silently assumed.\n5. A 422 duplicate response is not counted as a plain success.\nFAIL if any item is missing or wrong. In the explanation, list which items failed.",
            "focus": "trace"
          }
        },
        {
          "name": "fetched-start-here",
          "type": "tool_used",
          "weight": 1,
          "config": {
            "tool": "WebFetch",
            "input_match": "START_HERE"
          }
        },
        {
          "name": "no-random-transaction-id-edit",
          "type": "tool_used",
          "weight": 1,
          "config": {
            "tool": "Edit",
            "input_match": "transaction_id\\W{0,8}(crypto\\.)?(randomUUID|uuid|nanoid|Date\\.now)",
            "min": 0,
            "max": 0
          }
        },
        {
          "name": "no-random-transaction-id-write",
          "type": "tool_used",
          "weight": 1,
          "config": {
            "tool": "Write",
            "input_match": "transaction_id\\W{0,8}(crypto\\.)?(randomUUID|uuid|nanoid|Date\\.now)",
            "min": 0,
            "max": 0
          }
        },
        {
          "name": "writes-explicit-timestamp",
          "type": "tool_used",
          "weight": 1,
          "config": {
            "tool": "Write",
            "input_match": "timestamp\\W{0,8}[^,}]{0,80}(createdAt|occurredAt|getTime|toFixed)"
          }
        },
        {
          "name": "writes-subscription-id-on-events",
          "type": "tool_used",
          "weight": 1,
          "config": {
            "tool": "Write",
            "input_match": "external_subscription_id"
